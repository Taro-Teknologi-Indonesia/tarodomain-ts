{
  "name": "@tarodomain/aws",
  "version": "0.0.0",
  "description": "TaroDomain AWS provider: DynamoDB adapters, SQS event bus and Lambda entry points",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taro-Teknologi-Indonesia/tarodomain-ts.git",
    "directory": "packages/aws"
  },
  "homepage": "https://github.com/Taro-Teknologi-Indonesia/tarodomain-ts/tree/main/packages/aws#readme",
  "bugs": "https://github.com/Taro-Teknologi-Indonesia/tarodomain-ts/issues",
  "keywords": [
    "tarodomain",
    "ddd",
    "event-sourcing",
    "cqrs",
    "saga",
    "aws"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1149.0",
    "@aws-sdk/lib-dynamodb": "3.1149.0",
    "@aws-sdk/client-sqs": "3.1149.0"
  },
  "peerDependencies": {
    "@tarodomain/core": "workspace:^"
  },
  "devDependencies": {
    "@tarodomain/core": "workspace:*",
    "@types/aws-lambda": "8.10.164"
  }
}
