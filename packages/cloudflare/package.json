{
  "name": "@tarodomain/cloudflare",
  "version": "0.0.0",
  "description": "TaroDomain Cloudflare provider: D1 adapters, Queues event bus, D1 unit of work and Worker entry point",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taro-Teknologi-Indonesia/tarodomain-ts.git",
    "directory": "packages/cloudflare"
  },
  "homepage": "https://github.com/Taro-Teknologi-Indonesia/tarodomain-ts/tree/main/packages/cloudflare#readme",
  "bugs": "https://github.com/Taro-Teknologi-Indonesia/tarodomain-ts/issues",
  "keywords": [
    "tarodomain",
    "ddd",
    "event-sourcing",
    "cqrs",
    "saga",
    "cloudflare"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@tarodomain/core": "workspace:^"
  },
  "devDependencies": {
    "@tarodomain/core": "workspace:*",
    "@cloudflare/workers-types": "5.20261011.1"
  }
}
